import { fetchGithubUserRepos } from "@/lib/githubApi";

export async function obterRepositorios(usuario) {
  try {
    const resposta = await fetchGithubUserRepos(usuario);

    if (resposta.status === 404) {
      return {
        repositorios: [],
        erro: "Usuário do GitHub não encontrado.",
      };
    }

    if (!resposta.ok) {
      return {
        repositorios: [],
        erro: `Erro ao carregar repositórios (Status: ${resposta.status}).`,
      };
    }

    const dados = await resposta.json();
    return {
      repositorios: dados,
      erro: "",
    };
  } catch {
    return {
      repositorios: [],
      erro: "Falha na conexão com a API do GitHub.",
    };
  }
}